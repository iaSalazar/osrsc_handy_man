# ==========================================================================
# Environment Configuration — EXAMPLE FILE
# ==========================================================================
# Copy to .env.local and fill in your real values.
# .env.local is in .gitignore — never commit real credentials.
#
# Source before running:  source .env.local
# ==========================================================================

# ---- OSRS Account Credentials ----
export OSRS_USERNAME="your_username_here"
export OSRS_PASSWORD="your_password_here"

# ---- Bank PIN (4 digits, no spaces) ----
export OSRS_BANK_PIN="2006"

# ---- Optional: PIN timing overrides (milliseconds) ----
# export OSRS_PIN_DIGIT_DELAY_MIN_MS=80
# export OSRS_PIN_DIGIT_DELAY_MAX_MS=250
# export OSRS_PIN_BETWEEN_DIGIT_MIN_MS=150
# export OSRS_PIN_BETWEEN_DIGIT_MAX_MS=450
